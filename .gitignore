# Source-only checkout: runtime/vendor and third-party assets stay local.
/src/vendor/*
!/src/vendor/README.md
/web/vendor/*
!/web/vendor/README.md
/web/assets/*
!/web/assets/README.md
/sources/motions/**/*.fbx
/sources/motions/**/*.glb
/sources/motions/**/*.bin
*.fbx
*.glb
*.wasm
*.zip
*.exe

# Local dependencies, user data and build artifacts.
node_modules/
dist/
reports/
.npm-cache/
.env
.env.*
*.log
*.pending
web/state/
web/assets/captures/
seed/*
/Assets/
!seed/.gitkeep
.DS_Store
Thumbs.db
