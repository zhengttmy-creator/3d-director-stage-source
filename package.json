{
  "name": "3d-director-stage",
  "productName": "绮绘预演台V1.5",
  "version": "1.5.0",
  "private": true,
  "description": "绮绘预演台：本地三维预演、动作、机位和时间轴",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "start:web": "node web/server.mjs",
    "build": "node scripts/build-vendor.cjs",
    "build:motions": "node src/motions/build-local-motions.mjs",
    "build:poses": "node src/motions/build-local-poses.mjs",
    "build:characters": "node src/characters/build-body-presets.mjs",
    "preview:characters": "node scripts/preview-characters.mjs",
    "test": "node tests/server.test.mjs",
    "test:previews": "node tests/motion-previews.test.mjs",
    "test:root-motion": "node tests/root-motion.test.mjs",
    "test:transforms": "node tests/transform-autokey.test.mjs",
    "test:drafts": "node tests/draft-recovery.test.mjs",
    "test:camera-targets": "node tests/camera-target-selection.test.mjs",
    "test:camera-position": "node tests/camera-position-autokey.test.mjs",
    "test:camera-navigation": "node tests/camera-navigation-sync.test.mjs",
    "test:manual-camera": "node tests/manual-camera-authoring.test.mjs",
    "test:new-camera": "node tests/new-camera-selection.test.mjs",
    "test:camera-transform": "node tests/camera-transform-model.test.mjs && node tests/camera-transform-authoring.test.mjs && node tests/camera-transform-ui.test.mjs",
    "test:manual-keyframes": "node tests/manual-timeline-keyframes.test.mjs",
    "test:curve-easing": "node tests/curve-easing.test.mjs",
    "test:bones": "node tests/skeletal-keyframes.test.mjs && node tests/skeletal-editor-sync.test.mjs && node tests/skeletal-editor-drag.test.mjs && node tests/skeletal-playback.test.mjs",
    "test:continuation": "node tests/pose-continuation-alignment.test.mjs && node tests/pose-continuation-editing.test.mjs",
    "test:camera-cuts": "node tests/camera-cut-sequencer.test.mjs && node tests/shot-delete-shortcuts.test.mjs && node tests/shot-timing-ui.test.mjs && node tests/camera-track-export.test.mjs && node tests/camera-row-sequencer.test.mjs && node tests/camera-layer-priority.test.mjs",
    "test:empty-cameras": "node tests/empty-cameras.test.mjs && node tests/empty-scene-startup.test.mjs && node tests/empty-camera-ui.test.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "dist:extension": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-extension.ps1",
    "test:extension": "node tests/extension-workers.test.mjs && node tests/extension-backend.test.cjs",
    "test:characters": "node tests/body-presets.test.mjs && node tests/body-preset-runtime.test.mjs",
    "test:assets": "node tests/asset-library.test.mjs && node tests/asset-server.test.mjs && node tests/folder-models.test.mjs",
    "test:poses": "node src/motions/test-pose-presets.mjs && node tests/pose-persistence.test.mjs && node tests/pose-library.test.mjs",
    "test:motions": "node src/motions/test-motion-loader.mjs && node src/motions/test-original-retarget.mjs",
    "dist:mac:arm64": "node scripts/package-mac.mjs",
    "test:mac-release": "node tests/mac-release.test.mjs",
    "dist:win": "npm run build && electron-builder --win portable --x64",
    "dist:win:all": "npm run build && electron-builder --config scripts/electron-builder-desktop.cjs --win --x64"
  },
  "devDependencies": {
    "@babel/parser": "7.29.2",
    "@babel/traverse": "7.29.0",
    "electron": "37.10.3",
    "electron-builder": "26.0.12",
    "png2icons": "2.0.1",
    "three": "0.184.0",
    "yazl": "3.3.1"
  },
  "build": {
    "appId": "cn.yuyantai.director",
    "productName": "绮绘预演台V1.5",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "web/**",
      "docs/**",
      "seed/.gitkeep",
      "app.ico",
      "package.json",
      "THIRD_PARTY.md",
      "!web/state/**",
      "!web/assets/captures/**"
    ],
    "win": {
      "icon": "app.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "artifactName": "${productName}-${arch}.${ext}"
  }
}
